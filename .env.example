# Copy to .env. Never commit .env. Day 1 defaults: everything fake, no keys needed.
APP_ENV=dev

# Nebius Token Factory (real model calls; DR-0 verified these IDs on this account Oct 6)
NEBIUS_API_KEY=
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_PROJECT_ID=                # for contree-sdk once Sandboxes approval lands
PLANNER_MODEL=nvidia/nemotron-3-super-120b-a12b
# Fixer: Ultra (quality-first — produced the recorded demo fix); Super is the cheaper first choice
FIXER_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
ESCALATION_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
AUDITOR_MODEL=nvidia/nemotron-3-super-120b-a12b          # text-only audit (no NVIDIA vision model on catalog)
AUDITOR_VISION_MODEL=openbmb/MiniCPM-V-4_5               # A/B candidate for the benchmark
LIGHTNING_MODEL=nvidia/Nemotron-3_5-Lightning
GUARD_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
EMBED_MODEL=Qwen/Qwen3-Embedding-8B

# Backends: fake until the real adapter lands (flip per dry run)
LLM_BACKEND=fake            # tokenfactory after DR-1
EAR_DRIVER=fake             # virtual after DR-3
SANDBOX_BACKEND=fake        # contree after beta approval (placeholder adapter in place)
SEARCH_BACKEND=cache        # tavily = live W3C pattern + WCAG doc retrieval (bonus lane)
VCS_BACKEND=fake            # github after DR-8
STORE_BACKEND=memory
EVENTS_BACKEND=inproc

RUN_TOKEN_BUDGET=400000
MAX_FIX_ROUNDS=2
FIX_CANDIDATES=3

REDIS_URL=redis://localhost:6379/0
DATABASE_URL=sqlite+aiosqlite:///./blindrun.db
TAVILY_API_KEY=               # free at app.tavily.com; empty => cached patterns
GITHUB_REPO=
